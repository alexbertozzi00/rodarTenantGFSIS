# Copie este arquivo para ".env" (na mesma pasta do script) e ajuste os valores.
# Linhas iniciadas com # sao ignoradas. Chave sem valor tambem e ignorada.
# Precedencia: parametro da linha de comando > .env > variavel de ambiente > padrao.

# Servidor Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres

# Senha. Fica em texto puro: prefira deixar vazio e usar o pgpass.conf ou digitar quando o script pedir.
PGPASSWORD=

# Prefixo dos bancos em que o script roda
PREFIXO=gestaofacil_

# Quantos bancos rodam ao mesmo tempo (1 a 16)
PARALELO=1
